# Raw server execution defaults to production. The npm launchers explicitly
# choose development or production; Playwright chooses test.
APP_ENV=production
PORT=3000
DATABASE_PATH=./data/app.db
POSTMARK_SERVER_TOKEN=PM-replace-with-real-token
POSTMARK_FROM=noreply@your-verified-domain.com
SESSION_EXPIRY_DAYS=90
# In explicit development mode, codes are logged at debug level — set LOG_LEVEL=debug to
# skip the inbox round-trip and grab the code from the server terminal.
LOGIN_CODE_EXPIRY_MINUTES=15
LOG_LEVEL=info
# Public origin for OAuth/MCP, e.g. https://usekcal.com (no path).
# Leave blank to disable the connector. Local Vite development: http://localhost:5173.
PUBLIC_ORIGIN=
# Requires APP_ENV=test; startup rejects this flag in every other mode.
# Disables Postmark and exposes
# GET /auth/test/last-code/:email for Playwright login codes.
TEST_MODE=false
# Comma-separated IP allowlist for /debug. Unset/empty → every caller is
# denied (fail-closed). Add a local/test IP (e.g. 127.0.0.1) if needed.
# Production always returns 404 regardless of this allowlist.
DEBUG_ALLOW_IPS=
# Express `trust proxy` setting. Default 'loopback'. Use your trusted proxy
# addresses/subnets so req.ip identifies clients correctly. The string "1"
# is not parsed as a numeric one-hop setting.
TRUST_PROXY=loopback
