{
  "name": "kcal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:journeys": "tsx scripts/check-journeys.ts",
    "check": "npm run typecheck && npm run typecheck:server && npm run typecheck:tests && npm run check:journeys",
    "server:dev": "APP_ENV=development tsx watch --env-file=.env server/index.ts",
    "server:start": "APP_ENV=production tsx --env-file=.env server/index.ts",
    "start": "npm run build && npm run server:start",
    "icons": "./scripts/regenerate-icons.sh",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordi735/kcal.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jordi735/kcal/issues"
  },
  "homepage": "https://github.com/jordi735/kcal#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "postmark": "^5.1.0",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openai/codex": "^0.154.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
